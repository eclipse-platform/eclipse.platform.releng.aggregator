// Constants read by job creation
private static final _JOB_DESCRIPTION = 'Runs all smoke tests for the Eclipse SDK.'

@groovy.transform.Field
def BUILD = null
@groovy.transform.Field // Result of each matrix cell (key: '<platform> / Java <version>')
def TEST_RESULTS = Collections.synchronizedMap([:])

pipeline {
	options {
		timeout(time: 300, unit: 'MINUTES')
		timestamps()
		buildDiscarder(logRotator(numToKeepStr:'10'))
		skipDefaultCheckout()
	}
	parameters {
		string(name: 'buildId', trim: true, description: 'Build Id to test (such as I20240611-1800, N20120716-0800).')
		string(name: 'testsToRun', defaultValue: 'ui', trim: true, description: '''\
			This can be any ant target from
			https://github.com/eclipse-platform/eclipse.platform.releng.aggregator/blob/master/production/testScripts/configuration/sdk.tests/testScripts/test.xml
		''')
	}
	agent none
	stages {
		stage('Fetch test configuration') {
			agent {
				label 'basic'
			}
			steps {
				checkout scmGit(userRemoteConfigs: [[url: "${scm.userRemoteConfigs[0].url}"]], branches: [[name: "${scm.branches[0].name}"]],
					extensions: [cloneOption(depth: 1, shallow: true, noTags: true), sparseCheckout([
					[path: 'jobs/buildConfigurations.json'],
				])])
				script {
					def jobFolderName = "${env.JOB_NAME}".split('/')[-2]
					echo "Job folder: $jobFolderName"
					BUILD = readJSON(file: 'jobs/buildConfigurations.json').values().find{ c -> c.folder == jobFolderName}
					if (BUILD == null) {
						error "Unsupported folder for smoke tests: ${jobFolderName}"
					}
				}
			}
		}
		stage('Smoke tests') {
			steps {
				script {
					def smokeTests = [:]
					BUILD.smokeTests.each{ test ->
						def versions = test.javaVersion instanceof List ? test.javaVersion : [ test.javaVersion ]
						return versions.collect{v -> v.toString()}.each{ javaVersion ->
							def executor;
							if (test.agent.type == 'static') {
								executor = createLabeledAgent(test.agent.label)
							} else if (test.agent.type == 'kubernetes') {
								executor = createKubernetesAgent(test.agent.image)
							} else {
								error "Unsupported agent type ${test.agent.type}"
							}
							smokeTests["${test.label} - Java ${javaVersion.toUpperCase()}"] = { runSmokeTest(executor, test.label, test.os, test.ws, test.arch, javaVersion) }
						}
					}
					parallel(smokeTests)
				}
			}
		}
	}
	post {
		unsuccessful {
			emailext subject: "Smoke test for ${buildId} - ${currentBuild.currentResult}", 
				body: """\
					Smoke tests failed for ${buildId}. Please review the logs:
					${BUILD_URL}
					
					Results per platform / Java version:
					""".stripIndent() + formatTestResults(TEST_RESULTS), mimeType: 'text/plain',
				to: BUILD.mailingList, from:"genie.releng@eclipse.org"
		}
	}
}

@NonCPS
def formatTestResults(Map<String, String> results) {
	def maxNameLength = results.keySet().collect{k -> k.length()}.max()
	return results.collect{ test, result -> '  ' + test.padRight(maxNameLength) + ' : ' + result }.sort().join('\n')
}

def runSmokeTest(Closure executorAgent, String name, String os, String ws, String arch, String javaVersion) {
	executorAgent.call({
		def result = 'FAILED' // stays like this if anything throws before the test results are evaluated
		cleanWs()
		try {
		def javaHome = installJDK(javaVersion, os, arch)
		def antHome = tool(type:'ant', name:'apache-ant-latest')
		def folderName = name.replace(' ','_').toLowerCase(Locale.ENGLISH)
		dir ("${WORKSPACE}/${folderName}-java${javaVersion}") { // run in a unique directory to allow distinction of archived build artifacts
			withEnv([
				"JAVA_HOME=${javaHome}", "ANT_HOME=${ antHome }",
				"WORKSPACE=${pwd()}", "PATH=${javaHome}/bin:${antHome}/bin:${PATH}",
				"ANT_OPTS=-Djava.io.tmpdir=${pwd()}/tmp"
			]) {
				xvnc(useXauthority: true) {
					if (os =='linux') {
						sh '''#!/bin/bash -x
							cat /etc/*release
							echo "whoami:  $(whoami)"
							echo "uname -a: $(uname -a)"
							
							# 0002 is often the default for shell users, but it is not when ran from
							# a cron job, so we set it explicitly, to be sure of value, so releng group has write access to anything
							# we create on shared area.
							oldumask=$(umask)
							umask 0002
							echo "umask explicitly set to 0002, old value was $oldumask"
							
							# we want java.io.tmpdir to be in $WORKSPACE, but must already exist, for Java to use it.
							mkdir -p tmp
							
							curl -o getEBuilder.xml https://download.eclipse.org/eclipse/relengScripts/testScripts/bootstrap/getEBuilder.xml
							
							echo JAVA_HOME: $JAVA_HOME
							echo ANT_HOME: $ANT_HOME
							echo PATH: $PATH
							
							env 1>envVars.txt 2>&1
							ant -diagnostics 1>antDiagnostics.txt 2>&1
							java -XshowSettings -version 1>javaSettings.txt 2>&1
							
							ant -f getEBuilder.xml -DbuildId=${buildId} \
							  -Dosgi.os=''' + os + ''' -Dosgi.ws=''' + ws + ''' -Dosgi.arch=''' + arch + ''' \
							  -DtestSuite=${testsToRun}
						'''
					} else{
						error('Not yet implemented OS: ' + os)
					}
				}
			}
		}
		def summary = junit keepLongStdio: true, testResults: '**/eclipse-testing/results/xml/*.xml'
		result = "${summary.failCount > 0 ? 'FAILED' : 'PASSED'} (${summary.passCount} passed, ${summary.failCount} failed, ${summary.skipCount} skipped)"
		} finally {
			TEST_RESULTS["${name} / Java ${javaVersion.toUpperCase()}"] = result
			archiveArtifacts allowEmptyArchive: true, artifacts: '**/eclipse-testing/results/**, **/eclipse-testing/directorLogs/**, */*.properties, */*.txt'
			cleanWs()
		}
	})
}

def createKubernetesAgent(String imageName){
	return { body ->
		podTemplate(inheritFrom: 'basic' /* inherit general configuration */, containers: [
			containerTemplate(name: 'custom', image: imageName,
				resourceRequestCpu:'1000m', resourceRequestMemory:'512Mi',
				resourceLimitCpu:'1000m', resourceLimitMemory:'2048Mi',
				alwaysPullImage: true, command: 'cat', ttyEnabled: true)
		]) {
			node(POD_LABEL) { stage('Run tests') { container('custom') { body() } } }
		}
	}
}

def createLabeledAgent(String agentLabel){
	return { body -> node(agentLabel) { stage('Run tests') { body() } } }
}

def installJDK(String version, String os, String arch) {
	String releaseType = 'ga'
	if (version.endsWith('-ea')) {
		releaseType = 'ea'
		version = version.substring(0, version.length() - 3)
	}
	// Translate os/arch names that are different in the Adoptium API
	if (os == 'win32') {
		os = 'windows'
	} else if (os == 'macosx') {
		os = 'mac'
	}
	if (arch == 'x86_64') {
		arch = 'x64'
	}
	dir ("${WORKSPACE}/java") {
		sh "curl -L https://api.adoptium.net/v3/binary/latest/${version}/${releaseType}/${os}/${arch}/jdk/hotspot/normal/eclipse | tar -xzf -"
		return "${pwd()}/" + sh(script: 'ls', returnStdout: true).trim()
	}
}
